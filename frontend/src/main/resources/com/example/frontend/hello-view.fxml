<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #F72D16;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.frontend.HelloController">

    <children>
      <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
        <Label fx:id="welcomeText" text="Appuyer pour continuer" textFill="#ffd700">
         <font>
            <Font name="Ubuntu Regular" size="96.0" />
         </font></Label>
      <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />

        <HBox alignment="BOTTOM_RIGHT" spacing="30.0">
            <children>
                <ImageView fx:id="flag" fitHeight="100.0" fitWidth="125.0" onMouseClicked="#switch_language" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@img/gb.png" />
                    </image>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
               <effect>
                  <DropShadow />
               </effect>
                </ImageView>
            </children>
            <VBox.margin>
                <Insets bottom="30.0" right="1.0" top="10.0" />
            </VBox.margin>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
