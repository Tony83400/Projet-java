{
  "openapi": "3.0.3",
  "info": {
    "title": "",
    "version": ""
  },
  "paths": {
    "/commandes": {
      "get": {
        "tags": [
          "Commandes"
        ],
        "summary": "Récupérer toutes les commandes",
        "operationId": "getAllCommandes",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Liste des commandes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commande"
                }
              }
            }
          }
        },
        "deprecated": false,
        "security": []
      },
      "post": {
        "tags": [
          "Commandes"
        ],
        "summary": "Ajouter une nouvelle commande",
        "operationId": "addCommande",
        "parameters": [],
        "requestBody": {
          "description": "Données de la commande",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Commande créée avec succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commande"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides"
          }
        },
        "deprecated": false,
        "security": []
      }
    },
    "/commandes/{id}": {
      "get": {
        "tags": [
          "Commandes"
        ],
        "summary": "Trouve une commande par id",
        "operationId": "getCommandeById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID de la commande",
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commande trouvée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commande"
                }
              }
            }
          },
          "404": {
            "description": "Commande introuvable"
          }
        },
        "deprecated": false,
        "security": []
      }
    },
    "/commandes/{id}/lignes": {
      "get": {
        "tags": [
          "Commandes"
        ],
        "summary": "Récupérer les lignes d\u0027une commande",
        "operationId": "getLignesForCommande",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID de la commande",
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des lignes de la commande"
          },
          "404": {
            "description": "Commande introuvable"
          }
        },
        "deprecated": false,
        "security": []
      }
    },
    "/commandes/{id}/total": {
      "get": {
        "tags": [
          "Commandes"
        ],
        "summary": "Récupérer le prix total d\u0027une commande",
        "operationId": "getTotalForCommande",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID de la commande",
            "required": true,
            "deprecated": false,
            "allowEmptyValue": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prix total de la commande",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Commande introuvable"
          }
        },
        "deprecated": false,
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "Commande": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commande_id": {
            "type": "integer",
            "format": "int32"
          },
          "statut": {
            "type": "string"
          },
          "numero_ticket": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "commande_id",
          "numero_ticket"
        ]
      },
      "CommandeItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "articleId": {
            "type": "integer",
            "format": "int32"
          },
          "menuId": {
            "type": "integer",
            "format": "int32"
          },
          "quantite": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "quantite"
        ]
      },
      "CommandeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommandeItem"
            }
          }
        }
      }
    }
  }
}